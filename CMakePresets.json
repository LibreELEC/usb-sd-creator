{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-ninja",
      "inherits": "release",
      "generator": "Ninja"
    },
    {
      "name": "release-macos",
      "inherits": "release-ninja",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      }
    },
    {
      "name": "release-msvc",
      "inherits": "release",
      "generator": "NMake Makefiles"
    },
    {
      "name": "release-mingw-static",
      "inherits": "release-ninja",
      "cacheVariables": {
        "STATIC_BUILD": "ON",
        "ZLIB_USE_STATIC_LIBS": "ON",
        "OPENSSL_USE_STATIC_LIBS": "ON",
        "OPENSSL_DEPENDENCIES": "-lws2_32;-lgdi32;-lcrypt32;-lbcrypt",
        "LIBPNG_DEPENDENCIES": "-lz",
        "FREETYPE_DEPENDENCIES": "-lharfbuzz;-lgraphite2;-lglib-2.0;-lintl;-liconv;-lpcre2-8;-lfreetype;-lbz2;-lpng16;-lz;-lbrotlidec;-lbrotlicommon;-lws2_32;-lusp10;-lgdi32;-lole32;-lwinmm;-lshlwapi;-lrpcrt4;-lm",
        "HARFBUZZ_DEPENDENCIES": "-lfreetype;-lbz2;-lpng16;-lz;-lbrotlidec;-lbrotlicommon;-lgraphite2;-lglib-2.0;-lintl;-liconv;-lpcre2-8;-lws2_32;-lusp10;-lgdi32;-lole32;-lwinmm;-lshlwapi;-lrpcrt4;-lm"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "packagePresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "verbose": true
      }
    }
  ]
}
